<?xml version="1.0" encoding="utf-8"?>
<!-- هیچ داتایەکی ئەپ Backup ناکرێت و بۆ مۆبایلێکی تر ناگوازرێتەوە:
     دابەزاندنی نوێ وەک یەکەم جار دەبێت (هەڵبژاردنی زمان)، و session ـی
     چوونەژوورەوە لە Backup ـدا نامێنێت. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
